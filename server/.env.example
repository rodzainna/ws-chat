DATABASE_URL="postgresql://dev:dev@localhost:5432/ws_chat"
# openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
# needs a unit (m/h/d)
JWT_ACCESS_TOKEN_EXPIRY="15m"
JWT_REFRESH_TOKEN_EXPIRY_DAYS="3"
CORS_ORIGIN="http://localhost:5173"
PORT="8080"
NODE_ENV="development"
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"
RATE_LIMIT_MAX_MESSAGES="10"
RATE_LIMIT_WINDOW_SECONDS="10"
RATE_LIMIT_MAX_ROOM_CREATIONS="5"
RATE_LIMIT_ROOM_CREATION_WINDOW_SECONDS="300"
MAX_ROOMS="50"
RATE_LIMIT_MAX_REGISTRATIONS="5"
RATE_LIMIT_REGISTRATION_WINDOW_SECONDS="3600"
MAX_USERS="500"
# optional; this account can't be demoted or deactivated
SUPERADMIN_USERNAME="superadmin"
