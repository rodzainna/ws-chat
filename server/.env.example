PORT="8080"
NODE_ENV="development"
LOGIN_RATE_LIMIT_MAX_ATTEMPTS="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"
RATE_LIMIT_MAX_MESSAGES="10"
RATE_LIMIT_WINDOW_SECONDS="10"
